# shellcheck shell=bash

##
# Git add all files, commit with message and options, and push
#
# This assumes a push remote is already setup
gitacp() {
  git add . || return 1
  git commit "$@" || return 1
  git push || return 1
  return 0
}

##
# git show with external diff tool
git() {
  if [ "$1" = "show" ]; then
    shift
    command git show --ext-diff "$@"
  else
    command git "$@"
  fi
}

