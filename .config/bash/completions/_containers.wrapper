# shellcheck shell=bash

# bash completion support for containers script
if ! declare -f __containers >/dev/null 2>&1; then
  __containers_names() {
    local cmd="$1"
    local name word used
    local available=()

    for name in $("${cmd}" ps --noheading --format '{{ .Names }}'); do
      used=0
      for word in "${COMP_WORDS[@]:2:COMP_CWORD-2}"; do
        if [ "${word}" = "${name}" ]; then
          used=1
          break
        fi
      done

      if [ "${used}" -eq 0 ]; then
        available+=("${name}")
      fi
    done

    printf -- '%s\n' "${available[@]}"
  }

  __containers() {
    COMPREPLY=()
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local commands="ps logs images inspect reload disable restart status stop checkup pid prune pull teardown exec shell stats networks"

    if [ "${COMP_CWORD}" -le 1 ]; then
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${commands}" -- "${cur}"))
      return 0
    fi

    case "${COMP_WORDS[1]}" in
    images | inspect | disable | restart | status | stop | stats | teardown)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "$(__containers_names "$1")" -- "${cur}"))
      ;;
    logs | pid | exec)
      if [ "${COMP_CWORD}" -eq 2 ]; then
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "$(__containers_names "$1")" -- "${cur}"))
      fi
      ;;
    esac

    return 0
  }
fi

# vim: set filetype=sh:
