# shellcheck shell=bash

# mise must activate in rc.d because each new shell it re-evaluates the tools available to it

# Mise either installed via package manager or through https://mise.run
if command -v mise >/dev/null 2>&1; then
  # Do NOT export shims onto the global path
  # https://mise.jdx.dev/configuration/settings.html#activate_shims
  export MISE_ACTIVATE_SHIMS=false

  # https://mise.jdx.dev/configuration/settings.html#color_theme
  export MISE_COLOR_THEME=catppuccin

  # No hooks
  export MISE_NO_HOOKS=true

  # No auto install
  export MISE_NOT_FOUND_AUTO_INSTALL=false

  # Activate
  eval "$(mise activate bash)"
fi

# vim: set filetype=sh :
