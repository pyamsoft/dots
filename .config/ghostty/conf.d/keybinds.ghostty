# This is a configuration file for Ghostty.

## Reset all keybinds
keybind = clear

## Quick terminal
keybind = global:cmd+\=toggle_quick_terminal

## Clipboard
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard

## Font Size
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

## Settings
keybind = ctrl+shift+f3=toggle_command_palette
keybind = ctrl+shift+f5=reload_config
keybind = ctrl+shift+q=quit

config-file = ?keybinds.ghostty.local
