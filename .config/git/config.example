[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[submodule]
	recurse = true
[log]
	follow = true
[init]
	defaultBranch = main
[commit]
	verbose = true
[core]
	compression = 4
[rebase]
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = true
[diff]
	external = difft --display inline
	noprefix = true
	algorithm = patience
[pager]
	difftool = true
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/ssh/allowed_git_signers

# vim: set filetype=gitconfig :
