#!/bin/sh

# Sometimes when closing the IDE, it leaves a lock file around
# Use this script to quickly remove the lock file

_remove_lock() {
  _app="$1"
  _folder="$2"
  _ask="$3"

  _old="$(pwd)"
  _target="app/${_app}/config/${_folder}"

  # Check exists
  if [ ! -d "${_target}" ]; then
    unset _old
    unset _app
    unset _folder
    unset _target
    return 0
  fi

  cd "${_target}" || {
    printf -- 'Failed to cd into target: %s\n' "${_target}"

    unset _old
    unset _app
    unset _folder
    unset _target
    return 1
  }

  for f in ./*/.lock; do
    # Make sure we have actually found a lock file
    if [ "$f" != "./*/.lock" ] && [ -e "$f" ]; then
      if [ "${_ask}" -eq 1 ]; then
        rm -v -i ./*/.lock || {
          printf -- 'Failed to remove lock file in target: %s\n' "${_target}"
        }
      else
        rm -v -f ./*/.lock || {
          printf -- 'Failed to remove lock file in target: %s\n' "${_target}"
        }
      fi
    fi
    unset f
  done
  unset f

  cd "${_old}" || {
    printf -- 'Failed to cd out of target: %s\n' "${_target}"

    unset _old
    unset _app
    unset _folder
    unset _target
    return 1
  }

  unset _old
  unset _app
  unset _folder
  unset _target
  return 0
}

main() {
  if [ -z "$1" ]; then
    _remove_lock "com.jetbrains.WebStorm" "JetBrains" 1
    _remove_lock "com.jetbrains.PyCharm-Community" "JetBrains" 1
    _remove_lock "com.google.AndroidStudio" "Google" 1
  else
    while [ -n "$1" ]; do
      pak="$1"

      if [ -z "${pak}" ]; then
        printf -- 'Must provide a flatpak ID and the name of the folder in config/\n'
        return 1
      fi
      shift

      config="$1"
      if [ -z "${config}" ]; then
        printf -- 'Must provide a flatpak ID and the name of the folder in config/\n'
        return 1
      fi
      shift

      _remove_lock "${pak}" "${config}" 1

      unset pak
      unset config
    done

    unset pak
    unset config
  fi
}

main "$@" || exit 1
exit 0
