#!/bin/sh

NAME="gamer::setup"

##
# Logs a message with newline, formatting, and a name tag
_log() {
  _msg="$1"
  shift

  printf -- "[%s]: ${_msg}\n" "${NAME}" "$@" || return 1

  unset _msg
  return 0
}

##
# Log a message to stderr
_elog() {
  _log "$@" 1>&2 || return 1
  return 0
}

_has_user() {
  if id -u "${_target_user}" >/dev/null 2>&1; then
    _log 'Target user %s already exists!' "${_target_user}"
    return 0
  fi

  return 1
}

_install_launcher() {
  _elog 'Install user launcher: %s' "${_target_user}"

  cat <<EOF | sudo tee /home/"${_target_user}"/bin/launcher >/dev/null || {
#!/bin/sh

# Export graphical environment if it exists
if [ -n "\${DISPLAY}" ]; then
  printf -- '${_target_user}::[launcher] Export DISPLAY into systemd: %s\n' "\${DISPLAY}"
  systemctl --user set-environment DISPLAY="\${DISPLAY}"
fi
if [ -n "\${WAYLAND_DISPLAY}" ]; then
  printf -- '[${_target_user}::launcher] Export WAYLAND_DISPLAY into systemd: %s\n' "\${WAYLAND_DISPLAY}"
  systemctl --user set-environment WAYLAND_DISPLAY="\${WAYLAND_DISPLAY}"
fi
if [ -n "\${XAUTHORITY}" ]; then
  printf -- '${_target_user}::[launcher] Export XAUTHORITY into systemd: %s\n' "\${XAUTHORITY}"
  systemctl --user set-environment XAUTHORITY="\${XAUTHORITY}"
fi

if [ -n "\${GAMER_GAMESCOPE}" ] && [ "\${GAMER_GAMESCOPE}" -ne 0 ]; then
  printf -- '${_target_user}::[launcher] Launch command with gametime: "%s"\n' "${_cmd} \$*"
  exec gametime "${_cmd}" "\$@"
else
  printf -- '${_target_user}::[launcher] Launch command: "%s"\n' "${_cmd} \$*"
  exec "${_cmd}" "\$@"
fi
EOF

    _elog 'Failed to install launcher.'
    return 1
  }

  return 0
}

_bash_files() {
  _elog 'Install user bash profile files: %s' "${_target_user}"

  sudo cp ./gaming-bashrc /home/"${_target_user}"/.bashrc || {
    _elog 'Failed to install bashrc for %s' "${_target_user}"
    return 1
  }

  sudo cp ./gaming-bash_profile /home/"${_target_user}"/.bash_profile || {
    _elog 'Failed to install bash_profile for %s' "${_target_user}"
    return 1
  }

  sudo cp ./gaming-bash_logout /home/"${_target_user}"/.bash_logout || {
    _elog 'Failed to install bash_logout for %s' "${_target_user}"
    return 1
  }

  return 0
}

_make_dirs() {
  _log 'Make user directories: %s' "${_target_user}"

  sudo mkdir -p \
    /home/"${_target_user}"/bin \
    /home/"${_target_user}"/.cache \
    /home/"${_target_user}"/.config/systemd/user \
    /home/"${_target_user}"/.config/environment.d \
    /home/"${_target_user}"/.local/share || return 1
  return 0
}

_take_ownership() {
  _log 'Claim user ownership: %s' "${_target_user}"

  # Update access perms
  sudo chown "${_target_user}:${_target_user}" -R /home/"${_target_user}" || {
    _elog 'Failed to own %s home' "${_target_user}"
    return 1
  }

  sudo chmod o-rwx -R /home/"${_target_user}" || {
    _elog 'Failed to close off %s home to OTHER' "${_target_user}"
    return 1
  }

  sudo chmod g+rwX -R /home/"${_target_user}" || {
    _elog 'Failed to allow %s home to GROUP' "${_target_user}"
    return 1
  }

  sudo chmod u+rwX -R /home/"${_target_user}" || {
    _elog 'Failed to allow %s home to USER' "${_target_user}"
    return 1
  }

  sudo chmod 700 /home/"${_target_user}"/bin/launcher || {
    _elog 'Failed to exec-mark bin scripts for user %s' "${_target_user}"
    return 1
  }

  return 0
}

_mask_systemd() {
  _log 'Mask systemctl services: %s' "${_target_user}"

  sudo mkdir -p /home/"${_target_user}"/.config/systemd/user || {
    _elog 'Failed to mkdir target systemctl config.d'
    return 1
  }

  # Instead of launching a pipewire server for this new user, we allow the user to connect to our
  # current user's pulseaudio server. This way we can control the volume of all applications from the same
  # sound server
  for _s in "pipewire.service" "pipewire-pulse.service" "pipewire.socket" "pipewire-pulse.socket"; do
    sudo ln -s -f /dev/null /home/"${_target_user}"/.config/systemd/user/"${_s}" || {
      _elog 'Failed to mask %s' "${_s}"
      return 1
    }
  done
  return 0
}

_create_user() {
  _log 'Create target user: %s' "${_target_user}"

  sudo useradd --create-home --shell /bin/bash --user-group "${_target_user}" || {
    _elog 'Unable to create target user: %s' "${_target_user}"
    return 1
  }

  return 0
}

main() {
  _target_user="$1"
  if [ -z "${_target_user}" ]; then
    _elog 'Need a target user to setup!'
    return 1
  fi

  case "${_target_user}" in
  *[!a-z0-9-]*)
    _elog 'Invalid target user name: %s' "${_target_user}"
    return 1
    ;;
  esac

  _cmd="${_target_user}"
  _target_user="gaming-${_target_user}"
  readonly _cmd
  readonly _target_user

  if ! _has_user; then
    _create_user || return 1
  fi

  _make_dirs || return 1
  _bash_files || return 1
  _mask_systemd || return 1
  _install_launcher || return 1
  _take_ownership || return 1

  return 0
}

main "$@" || exit 1
exit 0
