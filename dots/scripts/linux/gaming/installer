#!/bin/sh

NAME="gamer::installer"

##
# Logs a message with newline, formatting, and a name tag
_log() {
  _msg="$1"
  shift

  printf -- "[%s]: ${_msg}\n" "${NAME}" "$@" || return 1

  unset _msg
  return 0
}

##
# Log a message to stderr
_elog() {
  _log "$@" 1>&2 || return 1
  return 0
}

##
# Installer
#
# $1 flatpak app name
# $2 script to install from this directory
_installer() {
  app_name="$1"
  target="$2"
  script="$3"
  mark="$4"

  current_directory="$(pwd)"

  if [ ! -e "${script}" ]; then
    _elog 'Target script does not exist, skipping install: %s => %s' "${script}" "${app_name}"
    return 0
  fi

  _log 'Attempt install script %s into flatpak app %s' "${script}" "${app_name}"

  if [ -d "${HOME}/.var/app/${app_name}" ]; then
    cd "${HOME}/.var/app/${app_name}" || {
      _elog 'Failed to cd into flatpak app directory: %s' "${app_name}"
      return 1
    }

    mkdir -p "${target}" || {
      _elog 'Failed to create %s directory for app: %s' "${target}" "${app_name}"
      return 2
    }

    t="${target}/$(basename "${script}")"

    cp -f "${current_directory}/${script}" "$t" || {
      _elog 'Failed to copy script %s into %s directory for app: %s' "${script}" "${target}" "${app_name}"
      return 3
    }

    if [ "${mark}" -eq 1 ]; then
      chmod +x "$t" || {
        _elog 'Failed to mark script %s executable for app: %s' "${script}" "${app_name}"
        return 4
      }
    else
      chmod -x "$t" || {
        _elog 'Failed to mark script %s unexecutable for app: %s' "${script}" "${app_name}"
        return 4
      }
    fi

    cd "${current_directory}" || {
      _elog 'Failed to cd out of flatpak app directory: %s back to %s' "${app_name}" "${current_directory}"
      return 5
    }

    _log '    %s installed for flatpak app %s' "${script}" "${app_name}"

    unset t
    unset app_name
    unset target
    unset script
    unset mark
    unset current_directory
  fi

  return 0
}

_local_install() {
  script="$1"
  target="$2"
  current_directory="$(pwd)"

  _log 'SUDO: Attempt local install script %s into target %s/bin' "${script}" "${target}"

  t="${target}/bin/$(basename "${script}")"

  sudo cp -f "${current_directory}/${script}" "$t" || {
    _elog 'Failed to copy script %s into host %s' "${script}" "${target}"
    return 1
  }

  sudo chown "$(basename "${target}"):$(basename "${target}")" "$t" || {
    _elog 'Failed to own script %s as target user %s' "${script}" "$(basename "${target}")"
    return 1
  }

  sudo chmod 700 "$t" || {
    _elog 'Failed to mark script %s executable for host %s' "${script}" "${target}"
    return 2
  }

  _log 'SUDO:    %s installed for %s' "${script}" "$t"

  unset t
  unset target
  unset script
  unset current_directory
  return 0
}

_jail_install() {
  script="$1"
  target="$2"
  current_directory="$(pwd)"

  _log 'Attempt local install script %s into jail %s/bin' "${script}" "${target}"

  jail="${HOME}/.local/etc/jails/${target}"
  jail_bindir="${jail}/home/.local/bin"

  if [ ! -d "${jail}" ]; then
    _elog 'Ignore local install of %s into jail %s, does not exist' "${script}" "${target}"
    return 0
  fi

  t="${jail_bindir}/$(basename "${script}")"

  mkdir -p "${jail_bindir}" || {
    _elog 'Failed to make jail directory %s' "${jail_bindir}"
    return 1
  }

  cp -f "${current_directory}/${script}" "$t" || {
    _elog 'Failed to copy script %s into jail %s' "${script}" "${target}"
    return 2
  }

  chmod 700 "$t" || {
    _elog 'Failed to mark script %s executable for jail %s' "${script}" "${target}"
    return 2
  }

  _log '    %s installed for %s' "${script}" "$t"

  unset t
  unset jail
  unset jail_bindir
  unset target
  unset script
  unset current_directory
  return 0
}

_installer "com.heroicgameslauncher.hgl" ".local/bin" "gametime" 1 || exit 1
_installer "com.valvesoftware.Steam" ".local/bin" "gametime" 1 || exit 1
_installer "io.openrct2.OpenRCT2" ".local/bin" "gametime" 1 || exit 1
_installer "com.pokemmo.PokeMMO" ".local/bin" "gametime" 1 || exit 1
_installer "org.DolphinEmu.dolphin-emu" ".local/bin" "gametime" 1 || exit 1
_installer "com.usebottles.bottles" ".local/bin" "gametime" 1 || exit 1

_installer "com.heroicgameslauncher.hgl" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1
_installer "com.valvesoftware.Steam" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1
_installer "io.openrct2.OpenRCT2" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1
_installer "com.pokemmo.PokeMMO" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1
_installer "org.DolphinEmu.dolphin-emu" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1
_installer "com.usebottles.bottles" "config/vkBasalt" "vkBasalt.conf" 0 || exit 1

_installer "io.openrct2.OpenRCT2" ".local/bin" "openrct2/gametime-openrct2" 1 || exit 1
_installer "com.pokemmo.PokeMMO" ".local/bin" "pokemmo/gametime-pokemmo" 1 || exit 1
_installer "org.DolphinEmu.dolphin-emu" ".local/bin" "dolphin-emu/gametime-dolphin-emu" 1 || exit 1

# If we have gamescope locally, maybe we want this script too
if command -v gamescope >/dev/null 2>&1; then
  # Gaming as another user
  for _u in /home/gaming-*; do
    case "${_u}" in
    "/home/gaming-*") ;;
    *)
      _local_install "gametime" "${_u}" || exit 1
      ;;
    esac
  done

  # Jails
  _jail_install "gametime" "heroic"
  _jail_install "gametime" "steam"
  _jail_install "gametime" "dolphin-emu"
  _jail_install "gametime" "openrct2"
  _jail_install "gametime" "tetrio"
fi

exit 0
