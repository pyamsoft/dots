#!/bin/sh

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/container-launch
. "${PYAMSOFT_PATH}/lib/container-launch"

NAME="container-checkupd"

# Don't look up the same container but with different versions more than once
# This would happen if we were running hello-world:1 and pulled down hello-world:2
# which podman sees as 2 container images
__all_already_seen_containers=""

# rendercv - The image is not a "server" so we may not always have it, but still want to keep it up to date.
# httpie - The image is not a "server" so we may not always have it, but still want to keep it up to date.
# yt-dlp - The image is not a "server" so we may not always have it, but still want to keep it up to date.
readonly ADDITIONAL_CONTAINER_LOOKUP="ghcr.io/rendercv/rendercv
docker.io/alpine/httpie
ghcr.io/jauderho/yt-dlp
"

# immich-machine-learning - Like every PR and commit is a build, it's too large so skip it
# immich-postgres - Pinned to specific immich version, do not need to lookup updates
# valkey - Pinned to specific immich version, do not need to lookup updates
readonly SKIP_CONTAINER_LOOKUP="ghcr.io/immich-app/immich-machine-learning
ghcr.io/immich-app/immich-postgres
docker.io/valkey/valkey
ghcr.io/techno-tim/littlelink-server
"

_get_latest_tags() {
  _container="$1"

  if [ -z "${_container}" ]; then
    _log 'Missing required container name'
    unset _container
    return 1
  fi

  _log 'Container: %s' "${_container}"
  # Trim off the json, just get the list of tags
  # Remove anything like latest, beta, other unstable versions
  # Sort by reverse version order (newest version on top)
  # max 10

  # These containers are very large so skip them
  if [ -n "${SKIP_CONTAINER_LOOKUP}" ]; then
    for _skip_me in ${SKIP_CONTAINER_LOOKUP}; do
      if [ "${_skip_me}" = "${_container}" ]; then
        _log 'Skipping container lookup: %s\n' "${_container}"
        unset _skip_me
        unset _container
        return 0
      fi
      unset _skip_me
    done
    unset _skip_me
  fi

  { if _has_function crane >/dev/null 2>&1; then
    crane ls "${_container}"
  else
    skopeo list-tags "docker://${_container}" | tail -n +4 | head -n -2 | tr '"' ' ' | awk '{ print $1 }'
  fi; } | grep -v 'stable' | grep -v 'unstable' | grep -v 'beta' | grep -v 'staging' | grep -v 'nightly' | grep -v 'edge' | grep -v 'dev' | grep -v 'rc' | grep -v 'version' | grep -v 'arm64' | grep -v 'preview' | grep -v 'arm' | grep -v 'amd' | grep -v 'latest' |
    case "${_container}" in
    */wireguard)
      # This one publishes date strings X-Y-Z so we can't drop non-dot
      cat
      ;;
    *)
      # And only accept things that have a `.`
      # We don't want 14, or 14.0 or d519d20f
      # We want X.Y or X.Y.Z
      grep '\.' |
        case "${_container}" in
        */rendercv)
          grep -v 'sha'
          ;;
        */matterjs-server)
          grep -v '\-alpha\.' | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */unbound)
          grep -v 'openssl' | grep -v 'libevent' | grep -v 'canary'
          ;;
        */navidrome)
          grep -v 'sha' | grep -v 'pr-' | grep -v 'v0'
          ;;
        */beets)
          grep -v '2021.' | grep -v '\-ls'
          ;;
        */httpie)
          grep -v '3.5-0.9.9'
          ;;
        */jellyseerr)
          grep -v 'preview'
          ;;
        */jellyfin)
          grep -v '202.' | grep -v 'master'
          ;;
        */caddy)
          grep -v 'windows' | grep -v 'alpine' | grep -v 'builder'
          ;;
        */music-assistant/server)
          grep -v 'b' | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */linuxserver/homeassistant)
          grep -v 'ls'
          ;;
        */esphome)
          grep -v 'b' | grep -v 'stable' | grep -v 'cache-release' | grep "^$(date '+%Y')" | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */omada-controller)
          grep -v 'chromium' | grep -v 'openj' | grep -v 'test'
          ;;
        */cloudflare-ddns)
          grep -v '.sig' | grep -v 'artifacthub'
          ;;
        */uptime-kuma)
          grep -v 'base' | grep -v 'push' | grep -v 'migrat' | grep -v 'builder' | grep -v 'alpine' | grep -v 'test' | grep -v 'debian'
          ;;
        */crowdsec)
          grep -v 'slim' | grep 'debian'
          ;;
        */scrutiny)
          # Only full omni images
          # Only "full" tags
          # Exclude a "buggy" v1.53.1 release tag
          grep 'omnibus' | grep -v 'collector' | grep -v '^v' | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */beszel)
          # Only "full" tags
          grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */beszel-agent)
          # Alpine, full images
          grep 'alpine' | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */bazarr | */radarr | */prowlarr)
          grep -v 'ls' | grep -v 'libtorrent'
          ;;
        */sonarr)
          # Buggy 5.14 release
          grep -v 'ls' | grep -v 'libtorrent' | grep -v 5.14
          ;;
        */qbittorrent)
          # Buggy releases
          grep -v 'ls' | grep -v 'libtorrent' | grep -v 20.04.1 | grep -v 14.3.9
          ;;
        */readarr)
          grep -v 'nightly' | grep -v 'amd64' | grep -v 'arm64'
          ;;
        */byparr)
          grep -v '.sig' | grep -v 'main'
          ;;
        */eclipse-mosquitto)
          grep -v 'openssl'
          ;;
        */zigbee2mqtt)
          grep -v '^v' | grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        */samba)
          grep -E '[0-9]+\.[0-9]+\.[0-9]+'
          ;;
        *)
          cat
          ;;
        esac
      ;;
    esac | sort -r -V | head || {
    _log 'Failed to list most recent tags for: %s' "${_container}"
    unset _container
    return 1
  }

  unset _container
  return 0
}

_retrieve_latest_tags() {
  _tag_name="$1"

  if [ -z "${_tag_name}" ]; then
    _log 'Must provide container name to lookup tags'
    unset _tag_name
    return 1
  fi

  _skip=0

  # Check that we haven't already done this
  if [ -n "${__all_already_seen_containers}" ]; then
    for _c in ${__all_already_seen_containers}; do
      if [ "${_tag_name}" = "${_c}" ]; then
        _skip=1
        break
      fi
    done
  fi

  # Keep track
  if [ "${_skip}" -eq 0 ]; then
    if [ -z "${__all_already_seen_containers}" ]; then
      __all_already_seen_containers="${_tag_name}"
    else
      __all_already_seen_containers="${__all_already_seen_containers} ${_tag_name}"
    fi

    _get_latest_tags "${_tag_name}" || {
      unset _tag_name
      unset _skip
      return 1
    }
  fi

  unset _tag_name
  unset _skip
  return 0
}

_check_containers() {
  _cmd="$1"

  # A string of <name> <version> <name> <version>
  # shellcheck disable=SC2086
  _containers="$(${_cmd} images | grep -e '^docker\.io' -e '^ghcr\.io' | awk '{ printf $1 " " $2 " " }')"

  while :; do
    if [ -z "${_containers}" ]; then
      break
    fi

    _container_name="$(printf -- '%s' "${_containers}" | awk '{ print $1 }')"

    # Re-parse the containers output to move to the next container
    _containers="$(printf -- '%s' "${_containers}" | cut -f 3- -d ' ')"

    _retrieve_latest_tags "${_container_name}" || return 1
    unset _container_name
  done

  return 0
}

main() {
  # Our user
  _check_containers "${CONTAINER_CMD}" || {
    _log 'Failed checking containers for user'
    return 1
  }

  # Any containers delegates
  for _container_delegate_user in /home/containers-*; do
    _container_delegate_user="$(basename "${_container_delegate_user}")"

    # Check the delegated command exists
    if _has_function "${_container_delegate_user}"; then
      _check_containers "${_container_delegate_user}" || {
        _log 'Failed checking containers for delegate-user %s' "${_container_delegate_user}"
        return 1
      }
    fi

    unset _container_delegate_user
  done
  unset _container_delegate_user

  # Check again for root containers
  # We don't do this on MacOS since it runs a VM as root
  # Check only if our runner is podman, docker uses a root-daemon
  if ! _is_macos && _is_podman; then
    _check_containers "sudo ${CONTAINER_CMD}" || {
      _log 'Failed checking containers for root'
      return 1
    }
  fi

  # Any additional containers
  if [ -n "${ADDITIONAL_CONTAINER_LOOKUP}" ]; then
    for _c in ${ADDITIONAL_CONTAINER_LOOKUP}; do
      _retrieve_latest_tags "${_c}" || {
        _log 'Failed checking for additional container: %s' "${_c}"

        unset _c
        return 1
      }
      unset _c
    done
    unset _c
  fi

  return 0
}

main "$@" || exit 1
exit 0
