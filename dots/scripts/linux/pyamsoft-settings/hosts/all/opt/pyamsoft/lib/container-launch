##
# Create a new isolated bridge network
_network_isolate() {
  _network_name="${1:-${NAME}}"

  # Create our own network
  if _is_podman; then
    # Podman can "ignore" networks with the same name
    if [ "${CONTAINER_NETWORK_IP6}" -ne 0 ]; then
      "${CONTAINER_CMD}" network create --ignore --driver bridge --opt isolate=true --disable-dns --ipv6 -- "${_network_name}" >/dev/null || {
        _elog "Failed to create isolated network using %s -> %s" "${CONTAINER_CMD}" "${_network_name}"
        unset _network_name
        return 1
      }
    else
      "${CONTAINER_CMD}" network create --ignore --driver bridge --opt isolate=true --disable-dns -- "${_network_name}" >/dev/null || {
        _elog "Failed to create isolated network using %s -> %s" "${CONTAINER_CMD}" "${_network_name}"

        unset _network_name
        return 1
      }
    fi
  elif _is_macos_container; then
    if ! "${CONTAINER_CMD}" network ls --format 'table' | awk '{ print $1 }' | grep -q "^${_network_name}$"; then
      # MacOS has no driver configuration or isolation or anything really.
      # Also no IPv6 specifics
      "${CONTAINER_CMD}" network create "${_network_name}" >/dev/null || {
        _elog "Failed to create isolated network using %s -> %s" "${CONTAINER_CMD}" "${_network_name}"

        unset _network_name
        return 1
      }
    fi
  else
    # Docker must make sure the network doesn't already exist
    if ! "${CONTAINER_CMD}" network ls --format '{{.Name}}' | grep -qx "^${_network_name}$"; then
      if [ "${CONTAINER_NETWORK_IP6}" -ne 0 ]; then
        "${CONTAINER_CMD}" network create --driver bridge --opt com.docker.network.bridge.enable_icc=false --ipv6 -- "${_network_name}" >/dev/null || {
          _elog "Failed to create isolated network using %s -> %s" "${CONTAINER_CMD}" "${_network_name}"

          unset _network_name
          return 1
        }
      else
        "${CONTAINER_CMD}" network create --driver bridge --opt com.docker.network.bridge.enable_icc=false -- "${_network_name}" >/dev/null || {
          _elog "Failed to create isolated network using %s -> %s" "${CONTAINER_CMD}" "${_network_name}"

          unset _network_name
          return 1
        }
      fi
    fi
  fi

  # Attach our isolated network
  _add_network --network="${_network_name}"

  unset _network_name
  return 0
}

##
# Make a directory on the host
_host_mkdir() {
  _mount_d="$1"

  mkdir -p "${_mount_d}" || {
    _elog "Failed to create mount source %s" "${_mount_d}"

    unset _mount_d
    return 1
  }

  unset _mount_d
  return 0
}

##
# chmod a file or directory on the host
_host_chmod() {
  _chmod_mode="$1"
  _chmod_target="$2"

  chmod -R "${_chmod_mode}" "${_chmod_target}" || {
    _elog "Failed to chmod host directory %s (%s)" "${_chmod_target}" "${_chmod_mode}"
    unset _chmod_mode
    unset _chmod_target
    return 1
  }

  unset _chmod_mode
  unset _chmod_target
  return 0
}

##
# Bind most a host directory
_mount_bind() {
  _mount_src="$1"
  _mount_target="$2"
  _mount_options="$3"

  _host_mkdir "${_mount_src}" || {
    unset _mount_src
    unset _mount_target
    unset _mount_options
    return 1
  }

  if [ -n "${_mount_options}" ]; then
    _add_mounts --mount "type=bind,source=${_mount_src},target=${_mount_target},${_mount_options}"
  else
    _add_mounts --mount "type=bind,source=${_mount_src},target=${_mount_target}"
  fi

  unset _mount_src
  unset _mount_target
  unset _mount_options
  return 0
}

##
# Private
__require_function() {
  if ! _has_function "$1"; then
    _elog 'Function is required: %s' "$1"
    return 1
  fi

  return 0
}

##
# Private
__setup_network() {
  _prep_network || return 1

  # Evaluate this AFTER so that just incase the script
  # has changed CONTAINER_NETWORK_HOST_ROUTE from _prep_network, we will pick it up
  if [ "${CONTAINER_NETWORK_HOST_ROUTE}" ] && [ "${CONTAINER_NETWORK_HOST_ROUTE}" -ne 0 ]; then
    if _has_network 'container:*'; then
      _log 'Ignoring host routes. Container networking is already set.'
    elif ! _is_macos_container; then
      _add_network --add-host "localhost:127.0.0.1"
      _add_network --add-host "host.containers.internal:host-gateway"
      _add_network --add-host "host.docker.internal:host-gateway"
    fi
  fi

  return 0
}

##
# Private
__await_directory() {
  _awaiting="$1"
  if [ -z "${_awaiting}" ]; then
    _elog 'Must provide directory to await'
    return 1
  fi

  # Run a simple version command which should "start" the podman container runtime directory
  __container_version="$("${CONTAINER_CMD}" --version 2>/dev/null)" || {
    _elog 'Unable to check %s version.' "${CONTAINER_CMD}"
    return 1
  }

  if _is_linux && _is_podman; then
    # Wait for the podman folder to be available before launching
    # This folder is created "at some point" in response to podman commands being run
    _await_tries=0
    while [ ! -d "${_awaiting}" ]; do
      if [ "${_await_tries}" -ge 30 ]; then
        _elog 'Timed out after waiting for container runtime at %s' "${_awaiting}"
        unset _await_tries
        unset _awaiting
        return 1
      fi

      sleep 1 || {
        _elog 'Cancelled while waiting for container runtime to stand up at %s' "${_awaiting}"

        unset _await_tries
        unset _awaiting
        return 1
      }
    done
    unset _await_tries

    _log 'Container runtime is ready at %s: start %s' "${_awaiting}" "${NAME}"
  fi

  unset _awaiting
  return 0
}

##
# Private
__do_prep_mounts() {
  _prep_mounts || return 1

  # Mount host busybox into container
  if [ "${CONTAINER_DEBUG}" ] && [ "${CONTAINER_DEBUG}" -ne 0 ]; then
    if _has_function busybox; then
      _busybox_target="/run/busybox"
      _log 'Attach busybox for container debugging at %s' "${_busybox_target}"
      _add_mounts --mount "type=bind,source=$(command -v busybox),target=${_busybox_target}"
      unset _busybox_target
    else
      _elog 'Container debugging requested but busybox not available'
    fi
  fi
}

##
# Overridable
#
# Last minute changes
__do_finalize() {
  _finalize "$@" || return 1

  # Use our own recursive DNS (point containers to host 127.0.0.1:53)
  if [ -n "${CONTAINER_DNS_RESOLVER}" ] && [ "${CONTAINER_DNS_RESOLVER}" -eq 1 ]; then
    _has_dns=0
    for _net_arg in ${CONTAINER_NETWORK}; do
      case "${_net_arg}" in
      --dns | --dns=*)
        # We have our own DNS
        _has_dns=1
        break
        ;;
      *)
        ;;
      esac
      unset _net_arg
    done
    unset _net_arg

    if _has_network host; then
      _log 'Ignoring local DNS resolver - host networking already set'
    elif _has_network 'container:*'; then
      _log 'Ignoring local DNS resolver - container networking already set'
    elif [ "${_has_dns}" -eq 0 ]; then
      # Add the "container local DNS"
      # Many images hardcode Google which is lame.
      # Avoid the Google upstream by strictly opting into one DNS
      _local_dns=""

      # Only guaranteed for podman `pasta` ?
      if _is_podman; then
        _local_dns="169.254.1.1"
      fi

      if [ -n "${_local_dns}" ]; then
        _log 'Using local DNS resolver at %s' "${_local_dns}"
        _add_network --dns "${_local_dns}"
      else
        _elog 'Unable to discover the "container DNS resolver". Using image defaults'
      fi
      unset _local_dns
    else
      _log 'Ignoring local DNS resolver - custom DNS already set'
    fi
  fi
  unset _has_dns
}

##
# Overridable
#
# Default function for setting up Memory usage
_prep_memory() {
  if _is_linux; then
    # 80% of total ram
    _allow_ram_mb="$(awk '/^MemTotal:/ { print int($2 / 1024 * 8 / 10) }' /proc/meminfo)"

    if [ -n "${_allow_ram_mb}" ] && [ "${_allow_ram_mb}" -gt 0 ]; then
      _add_memory --memory "${_allow_ram_mb}M"
    else
      _elog 'Unable to read total RAM from /proc/meminfo. No memory limits.'
    fi

    unset _allow_ram_mb
  fi

  return 0
}

##
# Overridable
#
# Default function for setting up CPU usage
_prep_cpu() {
  if _is_linux; then
    _cpu_number="$(getconf _NPROCESSORS_ONLN)"

    if [ -n "${_cpu_number}" ] && [ "${_cpu_number}" -gt 2 ]; then
      # If we have more than 2 cores, allow a container to use most
      _add_cpu --cpus "$((_cpu_number - 2))"
    else
      # Otherwise, allocate a single core allowance
      _add_cpu --cpus 1
    fi
  fi

  unset _cpu_number
  return 0
}

##
# Overridable
#
# Default function for setting up system logging
_prep_log() {
  # On Linux, our user session executes from systemd and thus sets the systemd vars
  # like JOURNAL_STREAM and INVOCATION_ID
  #
  # We cannot reliably use them to sniff "am I being ran by systemd"
  #
  # As such our services set a special PYAM_SYSTEMD variable and we sniff that
  if _is_linux && [ -n "${PYAM_SYSTEMD}" ]; then
    if _is_podman; then
      _add_logs --log-driver journald
    elif _is_docker; then
      _add_logs --log-driver local
    fi
  fi

  # Disable healthchecks
  if [ "${CONTAINER_HEALTHCHECK_ALLOWED}" -eq 0 ]; then
    if ! _is_macos_container; then
      _add_logs --no-healthcheck
    fi
  fi

  return 0
}

##
# Overridable
#
# Default function for sourcing a run configuration
_prep_rc() {
  # Source the runtime config (so we don't have to hardcode keys)
  _runconf="${CONTAINER_RUNTIME_DIR}/${NAME}/runconfig.env"
  if [ -n "${CONTAINER_REQUIRE_RUNCONF}" ] && [ "${CONTAINER_REQUIRE_RUNCONF}" -ne 0 ]; then
    if [ ! -e "${_runconf}" ]; then
      _elog 'You must provide %s' "${_runconf}"
      return 1
    fi
  else
    if [ ! -e "${_runconf}" ]; then
      _log 'Optional runconf supported at %s' "${_runconf}"
    fi
  fi

  if [ -e "${_runconf}" ]; then
    # Don't follow symlinks
    if [ -L "${_runconf}" ]; then
      _elog '%s must be a regular file.' "${_runconf}"
      unset _runconf
      return 1
    fi

    # Must be owned by current user
    if _is_macos; then
      _owner_uid="$(stat -f %u "${_runconf}")"
      _perm="$(stat -f %Lp "${_runconf}")"
    else
      _owner_uid="$(stat -c %u "${_runconf}")"
      _perm="$(stat -c %a "${_runconf}")"
    fi
    if [ "${_owner_uid}" != "${_uid}" ]; then
      _elog '%s must be owned by current user %s != %s' "${_runconf}" "${_owner_uid}" "${_uid}"
      unset _owner_uid
      return 1
    fi

    # Must not be writable by group/others
    # *[2367][0-7] catches group-write (second-to-last digit in write set)
    # *[2367]      catches others-write (last digit in write set)
    case "${_perm}" in
    *[2367][0-7] | *[2367])
      _elog '%s permissions too open. Must only be writable by owner %s (%s)' "${_runconf}" "${_owner_uid}" "${_perm}"
      unset _owner_uid
      unset _perm
      return 1
      ;;
    esac
    unset _perm
    unset _owner_uid

    # Source the file into the environment
    # shellcheck disable=SC1090
    . "${_runconf}" || {
      _elog 'Unable to source runconfig %s' "${_runconf}"
      return 1
    }
  fi
  unset _runconf

  return 0
}

