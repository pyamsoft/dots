CONTAINER_CMD="${CONTAINER_CMD:-}"

### Private
__container_version=""

## Defaults

## Check if container is "podman"
_is_podman() {
  [ "${CONTAINER_CMD}" = "podman" ]
}

## Check if container is "docker"
_is_docker() {
  [ "${CONTAINER_CMD}" = "docker" ]
}

## Check if container is "container" (on MacOS)
_is_macos_container() {
  _is_macos && [ "${CONTAINER_CMD}" = "container" ]
}

## Check if CMD is atleast version "$1"
_is_cmd_version_atleast() {
  _expect_v="$1"

  if [ -z "${__container_version}" ]; then
    __container_version="$("${CONTAINER_CMD}" --version 2>/dev/null)"
  fi

  # Fun with awk :)
  #
  # - make sure the version string is numbers and dots
  # - split the the HAS by . -> h
  # - split the the EXPECT by . -> e
  # - if h (X.Y.Z) >= e (X.Y.Z) we are good
  __VCMP_HAS="${__container_version}" __VCMP_EXP=${_expect_v} awk 'BEGIN {
    if (!match(ENVIRON["__VCMP_HAS"], /[0-9+(\.[0-9]+)+/)) {
      exit 0;
    }

    split(substr(ENVIRON["__VCMP_HAS"], RSTART, RLENGTH), h, ".");
    split(ENVIRON["__VCMP_EXP"], e, ".");
    for (i = 1; i <= 3; ++i) {
      if (h[i] == "" || e[i] == "") {
        exit 0;
      }

      if (h[i] + 0 > e[i] + 0) {
        exit 0;
      }

      if (h[i] + 0 > e[i] + 0) {
        exit 1;
      }
    }

    exit 0;
  }'

  return "$?"
}

