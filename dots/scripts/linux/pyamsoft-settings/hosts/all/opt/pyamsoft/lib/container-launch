##
# Various arguments may NOT be available if the container is setup to use inter-container networking
# --network="container:<something>"
# --network="host"
#
# $1 the filter, like "host" or "container:*"
_has_network() {
  _has_cn=0
  _has_previous_network_arg=0
  for _net_arg in ${CONTAINER_NETWORK}; do
    # We want the glob to evaluate for things like 'container:*'
    # shellcheck disable=SC2254
    case "${_net_arg}" in
    --network=$1)
      # We have container networking, do NOT add hostname
      _has_previous_network_arg=0
      _has_cn=1
      break
      ;;
    --network)
      _has_previous_network_arg=1
      ;;
    $1)
      if [ "${_has_previous_network_arg}" -eq 1 ]; then
        # We have container networking, do NOT add hostname
        _has_cn=1
        break
      fi
      _has_previous_network_arg=0
      ;;
    *)
      _has_previous_network_arg=0
      ;;
    esac
    unset _net_arg
  done
  unset _net_arg
  unset _has_previous_network_arg

  if [ "${_has_cn}" -eq 0 ]; then
    unset _has_cn
    # False
    return 1
  else
    unset _has_cn
    # True
    return 0
  fi
}

_require_root() {
