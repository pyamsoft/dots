#!/bin/sh

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/container-launch
. "${PYAMSOFT_PATH}/lib/container-launch"

NAME="whisper"
IMAGE="docker.io/homeassistant/amd64-addon-whisper"
TAG="3.5.3"

CONTAINER_REQUIRE_RUNCONF=0
CONTAINER_REQUIRE_INIT=1
CONTAINER_ENTRYPOINT="python3"

if ! _is_linux; then
  # Runs with host networking, so do not use DNS resolver
  CONTAINER_DNS_RESOLVER=0
fi

# Customization
MODEL="${MODEL:-small-int8}"
STT_LIBRARY="${STT_LIBRARY:-faster-whisper}"

_prep_mounts() {
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/tmp" "/tmp" || return 1
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/data" "/data" || return 1
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/download" "/download" || return 1

  # For huggingface cache
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/cache" "/root/.cache" || return 1

  return 0
}

_prep_env() {
  return 0
}

_prep_network() {
  # On linux, we attach to the HASS container
  if _is_linux; then
    CONTAINER_NETWORK_HOST_ROUTE=0

    # Piggyback onto the home-assistant network
    _add_network --network="container:home-assistant"
  else
    # On MacOS we run standalone, just use host networking to keep things simple
    _add_network --network="host"
  fi
  return 0
}

_prep_caps() {
  return 0
}

_prep_ports() {
  _add_ports -p "127.0.0.1:10300:10300/tcp"
  return 0
}

_check_user() {
  _require_nonroot || return 1

  return 0
}

_finalize() {
  # Wake word command
  _add_args -m "wyoming_faster_whisper"
  _add_args --uri "tcp://0.0.0.0:10300"
  _add_args --beam-size 1
  _add_args --compute-type "int8"
  _add_args --language "en"
  _add_args --data-dir "/data"
  _add_args --download-dir "/download"

  # Customization
  _add_args --model "${MODEL}"
  _add_args --stt-library "${STT_LIBRARY}"

  if [ -n "${CPU_THREADS}" ]; then
    _add_args --cpu-threads "${CPU_THREADS}"
  fi

  if [ -n "${VAD_CLIP}" ] && [ "${VAD_CLIP}" -eq 1 ]; then
    _add_args --vad-clip
  fi

  # Can run as read-only root
  _add_rc --read-only

  return 0
}

main "$@" || exit 1
exit 0
