#!/bin/sh

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/container-launch
. "${PYAMSOFT_PATH}/lib/container-launch"

NAME="ollama"
IMAGE="docker.io/ollama/ollama"
TAG="0.9.6-rocm"

CONTAINER_REQUIRE_RUNCONF=0

_prep_mounts() {
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/data" "/root/.ollama" || return 1

  return 0
}

_prep_env() {
  return 0
}

_prep_network() {
  # On linux, we attach to the HASS container
  if _is_linux; then
    # Piggyback onto the home-assistant network
    _add_network --network="container:home-assistant"
  else
    # On MacOS we run standalone, just use host networking to keep things simple
    _add_network --network="host"
  fi
  return 0
}

_prep_caps() {
  return 0
}

_prep_ports() {
  # Only podman does not care if you do --network AND ports
  if _is_podman; then
    _add_ports -p "127.0.0.1:11434:11434/tcp"
  fi
  return 0
}

_check_user() {
  _require_nonroot || return 1

  return 0
}

_finalize() {
  # ROCM and GPU
  _add_rc --device "/dev/kfd:/dev/kfd"
  _add_rc --device "/dev/dri:/dev/dri"
  _add_rc --group-add="$(_get_gid_for_group "render")"
  _add_rc --group-add="$(_get_gid_for_group "video")"

  # Can run as read-only root
  _add_rc --read-only

  return 0
}

main "$@" || exit 1
exit 0
