#!/bin/sh

NAME="heroic"

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/common
. "${PYAMSOFT_PATH}/lib/common"
# shellcheck source=/opt/pyamsoft/flatpak/lib/common
. "${PYAMSOFT_PATH}/flatpak/lib/common"

readonly _pak="com.heroicgameslauncher.hgl"

main() {
  _enter_existing=0
  _args=""
  while [ -n "$1" ]; do
    case "$1" in
    --shell)
      shift

      if _is_flatpak_running "${_pak}"; then
        # Enter the existing instance
        _enter_existing=1

        _log "Enter existing %s instance" "${_pak}"
      else
        # Launch a new instance but with bash
        _args="${_args} --command=/bin/bash"

        _log "Launching shell %s instance" "${_pak}"
      fi
      ;;
    --offline)
      shift

      _args="${_args} --unshare=network"
      ;;
    *)
      break
      ;;
    esac
  done

  _path="${HOME}/.local/bin:/app/bin:/usr/bin:/usr/lib/extensions/vulkan/MangoHud/bin:/usr/lib/extensions/vulkan/gamescope/bin:/usr/lib/extensions/vulkan/OBSVkCapture/bin:/app/bin/heroic/resources/app.asar.unpacked/build/bin/linux"
  if [ "${_enter_existing}" -eq 1 ]; then
    flatpak enter "${_pak}" \
      env \
      PATH="${_path}" \
      /bin/bash -i -l \
      "$@"
    return "$?"
  else
    # shellcheck disable=SC2086
    flatpak run \
      --env="PATH=${_path}" \
      ${_args} \
      -- \
      "${_pak}" \
      "$@"
    return "$?"
  fi
}

main "$@"
exit "$?"
