#!/bin/sh

NAME="android-studio"

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/common
. "${PYAMSOFT_PATH}/lib/common"
# shellcheck source=/opt/pyamsoft/flatpak/lib/common
. "${PYAMSOFT_PATH}/flatpak/lib/common"

readonly _pak="com.google.AndroidStudio"

main() {
  def_path="/app/bin:/usr/bin:/usr/lib/sdk/llvm20/bin"
  dev_root="${HOME}/devel"
  android_root="${dev_root}/sdk/android"

  # Extensions

  # Local scripts
  path="${HOME}/.local/bin"

  # Android SDK
  path="${path}:/app/extra/jbr/bin"
  path="${path}:${android_root}/emulator"
  path="${path}:${android_root}/cdmline-tools/latest/bin"
  path="${path}:${android_root}/platform-tools"

  # Add other path bits regardless of "shell" mode, otherwise Terminal in IDE does not have node extension
  path="${path}:${HOME}/.var/app/${_pak}/data/node/bin"
  path="${path}:${HOME}/.var/app/${_pak}/data/cargo/bin"
  path="${path}:${HOME}/.var/app/${_pak}/data/python/bin"

  # Warn abound outdated builds
  _my_user_home="$(systemd-escape "${HOME}")"
  _path="${_username}:${_my_user_home}-.var-app-com.google.AndroidStudio-cache-Google-AndroidStudio"
  _warn_outdated "${_pak}" "${_path}"
  unset _my_user_home
  unset _path

  _java_wayland=1
  _enter_existing=0
  _args=""
  _jvm_args=""
  while [ -n "$1" ]; do
    case "$1" in
    --shell)
      shift

      if _is_flatpak_running "${_pak}"; then
        # Enter the existing instance
        _enter_existing=1

        _log "Enter existing %s instance" "${_pak}"
      else
        # Launch a new instance but with bash
        _args="${_args} --command=/bin/bash"

        _log "Launching shell %s instance" "${_pak}"
      fi

      # Do not pass java wayland
      _java_wayland=0
      ;;
    --release)
      shift

      # Prepare for release builds
      _args="${_args} --filesystem=${dev_root}/project/pyamsoft/android/android-assets"

      # And apply shell arguments
      _args="${_args} --command=/bin/bash"

      # Do not pass java wayland
      _java_wayland=0
      ;;
    --offline)
      shift

      _args="${_args} --unshare=network"
      ;;
    *)
      break
      ;;
    esac
  done

  if [ "${_enter_existing}" -eq 1 ]; then
    # shellcheck disable=SC2086
    _enter_existing_flatpak "${_pak}" "${_args}"
    return "$?"
  else
    if [ "${_java_wayland}" -eq 1 ]; then
      _jvm_args="-Dawt.toolkit.name=WLToolkit"
    fi

    readonly FP_ENV="${PYAMSOFT_PATH}/flatpak/lib/flatpak-env"

    # shellcheck disable=SC2086
    "${FP_ENV}" "${_pak}" \
      --with-env PATH "${path}:" "${def_path}" \
      --filesystem="${dev_root}/project/pyamsoft/tools" \
      --filesystem="${dev_root}/project/pyamsoft/android/app" \
      --filesystem="${dev_root}/project/pyamsoft/android/libraries" \
      --filesystem="${android_root}" \
      --env="PYAMSOFT_USE_FOOJAY=1" \
      --env="ANDROID_EMULATOR_USE_SYSTEM_LIBS=1" \
      --socket=wayland \
      ${_args} \
      -- \
      ${_jvm_args} \
      "$@"
    _ret="$?"

    # Kill gradle-daemon after exiting
    if command -v kill-gradle >/dev/null; then
      kill-gradle
    fi

    return "${_ret}"
  fi
}

main "$@"
exit "$?"
