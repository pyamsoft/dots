#!/bin/sh

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/container-launch
. "${PYAMSOFT_PATH}/lib/container-launch"

IMAGE="docker.io/ollama/ollama"

# Since this container is more of a "library", we could potentially have many instances
# as such, we do NOT need to enforce a hard-set name. A caller could override this by passing NAME=
# themselves when invoking this script.
NAME="${NAME:-ollama}"

# Since this container is more of a "library", we could potentially have many instances
# as such, we do NOT need to enforce a hard-set name. A caller could override this by passing TAG=
# themselves when invoking this script.
TAG="${TAG:-0.40.18}"

_prep_network() {
  _log 'Setup your network specifics in the runconfig.env'
  return 0
}

_prep_mounts() {
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/data" "/root/.ollama" || return 1
  _mount_bind "${CONTAINER_RUNTIME_DIR}/${NAME}/cache" "/root/.cache" || return 1

  return 0
}

_prep_env() {
  # Tweaks
  #
  # Enable vulkan
  # Use int q8 instead of float for kv cache
  # Bump context length
  # Never shutdown a model
  _add_env -e OLLAMA_VULKAN=1
  _add_env -e OLLAMA_FLASH_ATTENTION=1
  _add_env -e OLLAMA_KV_CACHE_TYPE=q8_0
  _add_env -e OLLAMA_KEEP_ALIVE=-1

  return 0
}

_prep_caps() {
  return 0
}

_prep_ports() {
  # Only podman does not care if you do --network AND ports
  if _is_podman; then
    _add_ports -p "127.0.0.1:11434:11434/tcp"
  fi
  return 0
}

_check_user() {
  _require_nonroot || return 1

  return 0
}

_finalize() {
  # ROCM and GPU
  _add_rc --device "/dev/kfd:/dev/kfd"
  _add_rc --device "/dev/dri:/dev/dri"
  _add_rc --group-add="$(_get_gid_for_group "render")"
  _add_rc --group-add="$(_get_gid_for_group "video")"

  # Can run as read-only root
  _add_rc --read-only

  return 0
}

main "$@" || exit 1
exit 0
