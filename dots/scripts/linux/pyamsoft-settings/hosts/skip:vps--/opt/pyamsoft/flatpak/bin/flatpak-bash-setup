#!/bin/sh

# Install the real machine's bash configuration into a flatpak application
#
# Makes it easier to run a nice bash shell in a flatpak container

# Source our common library
# shellcheck source=/opt/pyamsoft/lib/common
. "${PYAMSOFT_PATH}/lib/common"

NAME="$(basename "$0")"

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"

_require_bash_environment() {
  for _require_file in "${HOME}/.bashrc" "${HOME}/.bash_profile"; do
    if [ ! -f "${_require_file}" ]; then
      _elog 'Need a file at %s' "${_require_file}"

      unset _require_file
      return 1
    fi
  done
  unset _require_file

  if [ ! -d "${CONFIG_HOME}/bash" ]; then
    _elog 'Need bash configuration at %s' "${CONFIG_HOME}/bash"
    return 1
  fi

  return 0
}

_clean_bash_config() {
  _clean_dir="$1"

  # Remove everything that is not a .local file
  #
  # Find files
  # That are not .local
  # And do not live in a fullpath named .local.d
  # And remove them
  find "${_clean_dir}" \
    -mindepth 1 \
    -type f \
    ! -name '*.local' \
    ! -wholename '*.local.d/*' \
    -prune \
    -exec rm -f {} + || {
    unset _clean_dir
    return 1
  }

  unset _clean_dir
  return 0
}

_copy_bash_config() {
  _copy_src="$1"
  _copy_dst="$2"

  find "${_copy_src}" -type f | while IFS= read -r _f; do
    # Already exists, ignore
    if [ -e "${_copy_dst}/${_f}" ] || [ -L "${_copy_dst}/${_f}" ]; then
      continue
    fi

    case "${_f}" in
    */completions/* | */*.d/*)
      # Make directory and then move files
      _ff="${_f#"${_copy_src}/"}"
      mkdir -p "${_copy_dst}/${_ff%/*}" || return 1
      cp -P "${_f}" "${_copy_dst}/${_ff}" || return 1
      unset _ff
      ;;
    completions)
      # "completions" is a special bash directory
      _ff="${_f#"${_copy_src}/"}"
      mkdir -p "${_copy_dst}/${_ff%/*}" || return 1
      unset _ff
      ;;
    *)
      # This is an "install target" file
      _ff="${_f#"${_copy_src}/"}"
      cp -P "${_f}" "${_copy_dst}/${_ff}" || return 1
      unset _ff
      ;;
    esac
    unset _f
  done
  unset _f

  unset _copy_src
  unset _copy_dst
  return 0
}

_install_bash_environment() {
  _install_dir="$1"

  _log 'Create install directory: %s' "${_install_dir}/config/bash"
  mkdir -p "${_install_dir}/config/bash" || {
    _elog 'Failed to setup configuration directory %s' "${_install_dir}/config/bash"

    unset _install_dir
    return 1
  }

  _log 'Clean old configuration: %s' "${_install_dir}/config/bash"
  _clean_bash_config "${_install_dir}/config/bash" || {
    _elog 'Failed to remove old bash configuration from %s' "${_install_dir}/config/bash"

    unset _install_dir
    return 1
  }

  _log 'Copy host configuration: %s -> %s' "${CONFIG_HOME}/bash" "${_install_dir}/config/bash"
  _copy_bash_config "${CONFIG_HOME}/bash" "${_install_dir}/config/bash" || {
    _elog 'Failed to install bash configuration to %s' "${_install_dir}/config/bash"

    unset _install_dir
    return 1
  }

  # Optional starship install
  if [ -e "${CONFIG_HOME}/starship.toml" ]; then
    _log 'Copy starship configuration: %s -> %s' "${CONFIG_HOME}/starship.toml" "${_install_dir}/config/starship.toml"
    cp "${CONFIG_HOME}/starship.toml" "${_install_dir}/config/" || {
      _elog 'Failed to install starship configuration to %s' "${_install_dir}/config/"

      unset _install_dir
      return 1
    }
  fi

  for _install_file in .bashrc .bash_profile; do
    _log 'Copy bash file: %s -> %s' "${HOME}/${_install_file}" "${_install_dir}/${_install_file}"
    cp "${HOME}/${_install_file}" "${_install_dir}/${_install_file}" || {
      _elog 'Failed to install %s to %s' "${_install_file}" "${_install_dir}"

      unset _install_file
      unset _install_dir
      return 1
    }
  done
  unset _install_file

  unset _install_dir
  return 0
}

main() {
  _flatpak_id="$1"

  if [ -z "${_flatpak_id}" ]; then
    _elog 'Must pass flatpak ID'

    unset _flatpak_id
    return 1
  fi

  _require_bash_environment || {
    unset _flatpak_id
    return 1
  }

  _flatpak_directory="${HOME}/.var/app/${_flatpak_id}"
  unset _flatpak_id

  if [ ! -d "${_flatpak_directory}" ]; then
    _elog 'flatpak app directory must exist at %s' "${_flatpak_directory}"

    unset _flatpak_directory
    return 1
  fi

  _install_bash_environment "${_flatpak_directory}" || {
    unset _flatpak_directory
    return 1
  }

  unset _flatpak_directory
  return 0
}

main "$@"
exit "$?"
